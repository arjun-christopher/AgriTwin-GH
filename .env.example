# Environment Variables
# Copy this file to .env and set your actual values.
# .env is git-ignored; never commit real credentials.
#
# Quick start (development, no DB):
#   cp .env.example .env
#   python main.py               # FastAPI on port 8000
#   cd src/agritwin_gh/frontend && npm run dev   # Vite on port 5173

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_USER=your_database_user
DB_PASSWORD=your_secure_password
DB_NAME=agritwin_db
DB_HOST=localhost
DB_PORT=5432

# ── MinIO Object Storage ─────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# ── Weather / Sensor API Keys (optional) ─────────────────────────────────────
WEATHER_API_KEY=your_weather_api_key
SENSOR_API_KEY=your_sensor_api_key

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=your_secret_key_here

# ── FastAPI / AgriTwin backend ────────────────────────────────────────────────
# Enable the background DT simulation loop (requires a live DB).
# Set to 0 (default) for development / smoke testing without a DB.
AGRITWIN_BACKGROUND_LOOP=1
AGRITWIN_NO_FRONTEND=0

# Number of simulated DT steps to run when the background loop is enabled.
# Each step represents a 5-minute interval (288 steps ≈ 24 hours).
AGRITWIN_TOTAL_STEPS=288

# Interval between DT background steps in seconds (default: 300 = 5 min).
AGRITWIN_STEP_INTERVAL_SEC=300.0

# Set to 1 in CI / pytest to prevent the lifespan hook from starting the loop.
# Never set this in production.
TESTING=0

# ── Vite / React frontend ─────────────────────────────────────────────────────
# Create src/agritwin_gh/frontend/.env.local (or .env) and add:
#   VITE_API_BASE_URL=http://localhost:8000
#
# The file is already created at src/agritwin_gh/frontend/.env.local
# with this value.  Override for staging / production deployments.

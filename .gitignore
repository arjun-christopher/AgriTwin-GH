# MkDocs build output
site/

# Auto-generated by hooks.py (copied from README.md at build time)
docs/index.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.eggs/
dist/
/build/

# Unity WebGL build — tracked via Git LFS
# src/agritwin_gh/build/ is allowed (not matched by /build/ above)

# UV package manager
.uv-cache/
.python-version.bak

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data files (keep only .gitkeep)
data/raw/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/external/*
!data/external/.gitkeep
!data/README.md
feature_demos/data/*
feature_demos/figures/*

# Logs
logs/*
!logs/.gitkeep
*.log

# Configuration (environment-specific)
config/*.local.yaml
config/*.secret.yaml
.env
.env.local

# Frontend (React + Vite)
src/agritwin_gh/frontend/node_modules/
src/agritwin_gh/frontend/dist/
src/agritwin_gh/frontend/dist-ssr/
src/agritwin_gh/frontend/.vite/

# ─── Unity 3D Source Project (unity_module/) ──────────────────────────────────
# Auto-generated by Unity on open — safe to delete, Unity recreates them
unity_module/Library/
unity_module/Temp/
unity_module/obj/
unity_module/Logs/
unity_module/UserSettings/
unity_module/.vs/
unity_module/.vscode/

# IDE-generated project and solution files (regenerated by Unity / Rider / VS)
unity_module/*.csproj
unity_module/*.slnx
unity_module/*.sln
unity_module/*.suo
unity_module/*.user
unity_module/*.userprefs

# Crash and diagnostic artefacts
unity_module/sysinfo.txt
unity_module/crashlytics-build.properties